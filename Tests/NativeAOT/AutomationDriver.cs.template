using System;
using System.Linq;
using AutomationTool;
using UnrealSharp.Automation.Utilities;

// Unique command/assembly names prevent the integrated plugin from shadowing the test slot.
// All production commands and utilities are compiled verbatim from the selected slot.
public class NativeAOTValidateSLOT : BuildCommand
{
    public override void ExecuteBuild()
    {
        string action = ParseRequiredStringParam("NativeAOTAction");
        string[] allowed = ["GenerateProject", "GenerateSolution", "BuildSolution", "BuildUserGlue", "BuildUserSolution", "PackageProject"];
        if (!allowed.Contains(action)) throw new AutomationException("Unsupported validation action: " + action);
        Console.WriteLine("NATIVEAOT-AUTOMATION " + typeof(CommandUtilities).Assembly.Location);
        Console.WriteLine("NATIVEAOT-PLUGIN " + this.GetUnrealSharpRootFolder());
        Type commandType = typeof(CommandUtilities).Assembly.GetType("UnrealSharp.Automation.BuildCommands." + action, throwOnError: true)!;
        BuildCommand command = (BuildCommand)Activator.CreateInstance(commandType)!;
        command.Params = Params;
        command.ExecuteBuild();
    }
}
