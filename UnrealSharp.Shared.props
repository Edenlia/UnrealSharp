<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)..\..\</SolutionDir>
    <UnrealSharpPluginDir>$(MSBuildThisFileDirectory)</UnrealSharpPluginDir>
    <UnrealSharpIsInstalled>$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(UnrealSharpPluginDir)UnrealSharp.uplugin')), '&quot;Installed&quot;\s*:\s*true'))</UnrealSharpIsInstalled>
    <UnrealSharpRuntimeIdFile>$(UnrealSharpPluginDir)Intermediate/UnrealSharp/UHT/Editor/Runtime.id</UnrealSharpRuntimeIdFile>
    <UnrealSharpRuntimeId Condition="'$(UnrealSharpIsInstalled)' == 'true' And Exists('$(UnrealSharpRuntimeIdFile)')">$([System.IO.File]::ReadAllText('$(UnrealSharpRuntimeIdFile)').Trim())</UnrealSharpRuntimeId>
    <UnrealSharpRuntimeDirectory Condition="'$(UnrealSharpRuntimeDirectory)' == '' And '$(UnrealSharpIsInstalled)' == 'true'">$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))/.unrealsharp/Runtime/$(UnrealSharpRuntimeId)/Editor/Development/bin/$(TargetFramework)</UnrealSharpRuntimeDirectory>
    <UnrealSharpRuntimeDirectory Condition="'$(UnrealSharpRuntimeDirectory)' == ''">$(UnrealSharpPluginDir)Binaries\Managed\$(TargetFramework)</UnrealSharpRuntimeDirectory>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  
  <Import Project="$(UnrealSharpPluginDir)UnrealSharp.AOT.props" Condition="Exists('$(UnrealSharpPluginDir)UnrealSharp.AOT.props')" />
  <Import Project="$(UnrealSharpPluginDir)UnrealSharp.Build.props" Condition="Exists('$(UnrealSharpPluginDir)UnrealSharp.Build.props')" />

  <ItemGroup>
  
    <Reference Include="UnrealSharp">
      <HintPath>$(UnrealSharpRuntimeDirectory)\UnrealSharp.dll</HintPath>
    </Reference>
	
	<Reference Include="UnrealSharp.Binds">
      <HintPath>$(UnrealSharpRuntimeDirectory)\UnrealSharp.Binds.dll</HintPath>
    </Reference>
	
    <Reference Include="UnrealSharp.Core">
      <HintPath>$(UnrealSharpRuntimeDirectory)\UnrealSharp.Core.dll</HintPath>
    </Reference>
	
    <Reference Include="UnrealSharp.Log">
      <HintPath>$(UnrealSharpRuntimeDirectory)\UnrealSharp.Log.dll</HintPath>
    </Reference>

    <Reference Include="UnrealSharp.Plugins">
      <HintPath>$(UnrealSharpRuntimeDirectory)\UnrealSharp.Plugins.dll</HintPath>
    </Reference>
    
  </ItemGroup>

  <ItemGroup Condition="'$(SkipIncludeAnalyzers)' == ''">
    <Analyzer Include="$(UnrealSharpPluginDir)Binaries\Managed\netstandard2.0\Newtonsoft.Json.dll" Private="false" CopyToPublishDirectory="Never" />
    <Analyzer Include="$(UnrealSharpPluginDir)Binaries\Managed\netstandard2.0\UnrealSharp.GlueGenerator.dll" Private="false" CopyToPublishDirectory="Never" />
    <Analyzer Include="$(UnrealSharpPluginDir)Binaries\Managed\netstandard2.0\UnrealSharp.Analyzers.dll" Private="false" CopyToPublishDirectory="Never" />
    <Analyzer Include="$(UnrealSharpPluginDir)Binaries\Managed\netstandard2.0\UnrealSharp.CodeFixer.dll" Private="false" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <Analyzer Include="$(UnrealSharpPluginDir)Binaries\Managed\netstandard2.0\UnrealSharp.SourceGenerators.dll" Private="false" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
